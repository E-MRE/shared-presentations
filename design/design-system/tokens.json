{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Vektor Design Tokens",
  "version": "1.0.0",
  "description": "Üç katmanlı tasarım token mimarisi (Primitive -> Semantic -> Component)",
  "primitives": {
    "color": {
      "neutral": {
        "0": "#FFFFFF",
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "850": "#141A24",
        "900": "#0F172A",
        "950": "#090D16"
      },
      "brand": {
        "50": "#EEF2FF",
        "100": "#E0E7FF",
        "200": "#C7D2FE",
        "300": "#A5B4FC",
        "400": "#818CF8",
        "500": "#6366F1",
        "600": "#4F46E5",
        "700": "#4338CA",
        "800": "#3730A3",
        "900": "#312E81"
      },
      "emerald": {
        "50": "#ECFDF5",
        "100": "#D1FAE5",
        "400": "#34D399",
        "500": "#10B981",
        "600": "#059669",
        "700": "#047857"
      },
      "amber": {
        "50": "#FFFBEB",
        "100": "#FEF3C7",
        "400": "#FBBF24",
        "500": "#F59E0B",
        "600": "#D97706",
        "700": "#B45309"
      },
      "rose": {
        "50": "#FFF1F2",
        "100": "#FFE4E6",
        "400": "#FB7185",
        "500": "#F43F5E",
        "600": "#E11D48",
        "700": "#BE123C"
      }
    },
    "typography": {
      "fontFamily": {
        "sans": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
      },
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem"
      },
      "fontWeight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "lineHeight": {
        "tight": "1.15",
        "snug": "1.3",
        "normal": "1.5",
        "relaxed": "1.65"
      },
      "letterSpacing": {
        "tight": "-0.025em",
        "snug": "-0.015em",
        "normal": "0em",
        "wide": "0.05em"
      }
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "2xl": "20px",
      "full": "9999px"
    },
    "transition": {
      "fast": "150ms cubic-bezier(0.16, 1, 0.3, 1)",
      "normal": "240ms cubic-bezier(0.16, 1, 0.3, 1)",
      "spring": "360ms cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "semantic": {
    "dark": {
      "background": {
        "canvas": "#090D16",
        "surface": "#0F172A",
        "surfaceRaised": "#141E33",
        "surfaceOverlay": "#18233C"
      },
      "text": {
        "primary": "#F8FAFC",
        "secondary": "#94A3B8",
        "muted": "#64748B",
        "inverse": "#090D16"
      },
      "border": {
        "subtle": "rgba(255, 255, 255, 0.08)",
        "medium": "rgba(255, 255, 255, 0.14)",
        "strong": "rgba(255, 255, 255, 0.22)"
      },
      "brand": {
        "primary": "#6366F1",
        "primaryHover": "#818CF8",
        "subtle": "rgba(99, 102, 241, 0.12)"
      },
      "status": {
        "published": "#10B981",
        "pending": "#F59E0B",
        "rejected": "#F43F5E"
      }
    },
    "light": {
      "background": {
        "canvas": "#F8FAFC",
        "surface": "#FFFFFF",
        "surfaceRaised": "#F1F5F9",
        "surfaceOverlay": "#E2E8F0"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#475569",
        "muted": "#64748B",
        "inverse": "#F8FAFC"
      },
      "border": {
        "subtle": "#E2E8F0",
        "medium": "#CBD5E1",
        "strong": "#94A3B8"
      },
      "brand": {
        "primary": "#4F46E5",
        "primaryHover": "#4338CA",
        "subtle": "rgba(79, 70, 229, 0.08)"
      },
      "status": {
        "published": "#059669",
        "pending": "#D97706",
        "rejected": "#E11D48"
      }
    }
  }
}
