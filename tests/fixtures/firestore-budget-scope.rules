// TEST-ONLY expression budget measurement.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() { return request.auth != null && request.auth.token.email_verified == true; }
    // Synthetic controls distinguish per-operation from aggregate transaction budget.
    function budgetSegment(value) {
      return value is int &&
        (value >= -1 && value <= 101) &&
        (value >= -2 && value <= 102) &&
        (value >= -3 && value <= 103) &&
        (value >= -4 && value <= 104) &&
        (value >= -5 && value <= 105) &&
        (value >= -6 && value <= 106) &&
        (value >= -7 && value <= 107) &&
        (value >= -8 && value <= 108) &&
        (value >= -9 && value <= 109) &&
        (value >= -10 && value <= 110) &&
        (value >= -11 && value <= 111) &&
        (value >= -12 && value <= 112) &&
        (value >= -13 && value <= 113) &&
        (value >= -14 && value <= 114) &&
        (value >= -15 && value <= 115) &&
        (value >= -16 && value <= 116) &&
        (value >= -17 && value <= 117) &&
        (value >= -18 && value <= 118) &&
        (value >= -19 && value <= 119) &&
        (value >= -20 && value <= 120) &&
        (value >= -21 && value <= 121) &&
        (value >= -22 && value <= 122) &&
        (value >= -23 && value <= 123) &&
        (value >= -24 && value <= 124) &&
        (value >= -25 && value <= 125) &&
        (value >= -26 && value <= 126) &&
        (value >= -27 && value <= 127) &&
        (value >= -28 && value <= 128) &&
        (value >= -29 && value <= 129) &&
        (value >= -30 && value <= 130) &&
        (value >= -31 && value <= 131) &&
        (value >= -32 && value <= 132) &&
        (value >= -33 && value <= 133) &&
        (value >= -34 && value <= 134) &&
        (value >= -35 && value <= 135) &&
        (value >= -36 && value <= 136) &&
        (value >= -37 && value <= 137) &&
        (value >= -38 && value <= 138) &&
        (value >= -39 && value <= 139) &&
        (value >= -40 && value <= 140) &&
        (value >= -41 && value <= 141) &&
        (value >= -42 && value <= 142) &&
        (value >= -43 && value <= 143) &&
        (value >= -44 && value <= 144) &&
        (value >= -45 && value <= 145) &&
        (value >= -46 && value <= 146) &&
        (value >= -47 && value <= 147) &&
        (value >= -48 && value <= 148) &&
        (value >= -49 && value <= 149) &&
        (value >= -50 && value <= 150);
    }
    function withinBudget() {
      return budgetSegment(request.resource.data.value);
    }
    function overBudgetSegment(value) {
      return value is int &&
        (value >= -1 && value <= 101) &&
        (value >= -2 && value <= 102) &&
        (value >= -3 && value <= 103) &&
        (value >= -4 && value <= 104) &&
        (value >= -5 && value <= 105) &&
        (value >= -6 && value <= 106) &&
        (value >= -7 && value <= 107) &&
        (value >= -8 && value <= 108) &&
        (value >= -9 && value <= 109) &&
        (value >= -10 && value <= 110) &&
        (value >= -11 && value <= 111) &&
        (value >= -12 && value <= 112) &&
        (value >= -13 && value <= 113) &&
        (value >= -14 && value <= 114) &&
        (value >= -15 && value <= 115) &&
        (value >= -16 && value <= 116) &&
        (value >= -17 && value <= 117) &&
        (value >= -18 && value <= 118) &&
        (value >= -19 && value <= 119) &&
        (value >= -20 && value <= 120) &&
        (value >= -21 && value <= 121) &&
        (value >= -22 && value <= 122) &&
        (value >= -23 && value <= 123) &&
        (value >= -24 && value <= 124) &&
        (value >= -25 && value <= 125) &&
        (value >= -26 && value <= 126) &&
        (value >= -27 && value <= 127) &&
        (value >= -28 && value <= 128) &&
        (value >= -29 && value <= 129) &&
        (value >= -30 && value <= 130) &&
        (value >= -31 && value <= 131) &&
        (value >= -32 && value <= 132) &&
        (value >= -33 && value <= 133) &&
        (value >= -34 && value <= 134) &&
        (value >= -35 && value <= 135) &&
        (value >= -36 && value <= 136) &&
        (value >= -37 && value <= 137) &&
        (value >= -38 && value <= 138) &&
        (value >= -39 && value <= 139) &&
        (value >= -40 && value <= 140) &&
        (value >= -41 && value <= 141) &&
        (value >= -42 && value <= 142) &&
        (value >= -43 && value <= 143) &&
        (value >= -44 && value <= 144) &&
        (value >= -45 && value <= 145) &&
        (value >= -46 && value <= 146) &&
        (value >= -47 && value <= 147) &&
        (value >= -48 && value <= 148) &&
        (value >= -49 && value <= 149) &&
        (value >= -50 && value <= 150);
    }
    function overBudget() {
      let value = request.resource.data.value;
      return overBudgetSegment(value) && overBudgetSegment(value + 1) &&
        overBudgetSegment(value + 2) && overBudgetSegment(value + 3);
    }
    match /withinBudget/{id} { allow create: if isMember() && withinBudget(); }
    match /overBudget/{id} { allow create: if isMember() && overBudget(); }

  }
}
