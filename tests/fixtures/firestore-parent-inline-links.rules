// TEST PROTOTYPE ONLY — not configured for deployment.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Path Helpers ---

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function adminPath(uid) {
      return /databases/$(database)/documents/admins/$(uid);
    }

    function presentationPath(id) {
      return /databases/$(database)/documents/presentations/$(id);
    }

    // --- Authentication Helpers ---

    function isSignedIn() {
      return request.auth != null;
    }

    // A member is signed in AND (Google OAuth provider OR verified email)
    function isMember() {
      return isSignedIn() && (
        request.auth.token.firebase.sign_in_provider == 'google.com' ||
        request.auth.token.email_verified == true
      );
    }

    // Admin role marker doc exists in admins/{uid} (Console-only, client-write denied)
    function isAdmin() {
      return isMember() && exists(adminPath(request.auth.uid)) &&
        (!('active' in get(adminPath(request.auth.uid)).data) || get(adminPath(request.auth.uid)).data.active == true);
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Field and Manifest Validations ---

    function isHttpsUrl(url) {
      return url.size() <= 1000 && url.matches('^https://.+');
    }

    function isValidLink(link) {
      return link.keys().hasOnly(['label', 'url']) &&
        link.label.size() <= 100 && link.label.matches('(?s).+') &&
        isHttpsUrl(link.url);
    }

    function areValidLinks(links) {
      let count = links.size();
      return links is list && links.size() <= 10 &&
        (count < 1 || isValidLink(links[0])) &&
        (count < 2 || isValidLink(links[1])) &&
        (count < 3 || isValidLink(links[2])) &&
        (count < 4 || isValidLink(links[3])) &&
        (count < 5 || isValidLink(links[4])) &&
        (count < 6 || isValidLink(links[5])) &&
        (count < 7 || isValidLink(links[6])) &&
        (count < 8 || isValidLink(links[7])) &&
        (count < 9 || isValidLink(links[8])) &&
        (count < 10 || isValidLink(links[9]));
    }

    function validateSizes(sizes, kind) {
      return sizes.keys().hasOnly(['encoded', 'unpacked', 'fileCount']) &&
        sizes.encoded is int && sizes.encoded > 0 &&
        (kind == 'html' ? sizes.encoded <= 5242880 : sizes.encoded <= 8388608) &&
        sizes.unpacked is int && sizes.unpacked >= 0 &&
        sizes.fileCount is int && sizes.fileCount >= 1 &&
        (kind != 'html' || (sizes.unpacked <= 26214400 && sizes.fileCount <= 300));
    }

    function validateManifest(data) {
      return data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 12 &&
        data.sizes.encoded >= data.chunkCount && data.sizes.encoded <= 900000 * data.chunkCount;
    }

    function isValidTag(input) {
      return input.size() <= 32 && input.matches('.*[^ ].*');
    }
    function areValidTags(input) {
      let tags = input;
      let count = tags.size();
      return tags is list && count <= 8 && tags.toSet().size() == count &&
        (count < 1 || isValidTag(tags[0])) && (count < 2 || isValidTag(tags[1])) &&
        (count < 3 || isValidTag(tags[2])) && (count < 4 || isValidTag(tags[3])) &&
        (count < 5 || isValidTag(tags[4])) && (count < 6 || isValidTag(tags[5])) &&
        (count < 7 || isValidTag(tags[6])) && (count < 8 || isValidTag(tags[7]));
    }
    function areValidCatalog(data) {
      return (!('category' in data) || data.category in ['', 'Frontend & Flutter', 'AI & LLM', 'UI/UX & Design', 'Mimari & Backend']) &&
        (!('tags' in data) || areValidTags(data.tags));
    }

    function validateDeckFields(input) {
      let data = input;
      let allowedKeys = [
        'ownerUid', 'ownerName', 'ownerPhotoURL', 'title', 'description',
        'links', 'kind', 'fileName', 'status', 'rejectNote', 'cover',
        'coverSource', 'sizes', 'chunkCount', 'createdAt',
        'updatedAt', 'publishedAt', 'reviewedBy', 'reviewedAt',
        'manifestVersion', 'quotaMarker', 'category', 'tags'
      ];
      let requiredKeys = [
        'ownerUid', 'title', 'description', 'links', 'kind', 'fileName',
        'status', 'rejectNote', 'cover', 'coverSource', 'sizes',
        'chunkCount', 'createdAt', 'updatedAt',
        'manifestVersion', 'quotaMarker'
      ];

      return data.keys().hasOnly(allowedKeys) &&
        data.keys().hasAll(requiredKeys) &&
        data.ownerUid is string &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.description is string && data.description.size() <= 2000 &&
        areValidCatalog(data) &&
        areValidLinks(data.links) &&
        (data.kind == 'html' || data.kind == 'pptx') &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255 &&
        data.status in ['pending', 'published', 'rejected', 'unpublished'] &&
        data.rejectNote is string && data.rejectNote.size() <= 1000 &&
        data.cover is bytes && data.cover.size() <= 150000 &&
        data.coverSource in ['auto', 'upload', 'default'] &&
        validateSizes(data.sizes, data.kind) &&
        data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 12 &&
        data.manifestVersion is int && data.manifestVersion == 2 &&
        data.quotaMarker is string &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Quota & Transaction Binding Helpers ---

    function checkUserCreateWithDeck(uid) {
      let deckPath = presentationPath(request.resource.data.pendingDeckId);
      let deckAfter = getAfter(deckPath).data;
      return request.resource.data.pendingCount == 1 &&
        request.resource.data.pendingDeckId != null &&
        deckAfter.ownerUid == uid &&
        deckAfter.status == 'pending' &&
        deckAfter.quotaMarker == request.resource.data.pendingDeckId;
    }

    function checkUserIncrement(uid) {
      let deckPath = presentationPath(request.resource.data.pendingDeckId);
      let deckAfter = getAfter(deckPath).data;
      return request.resource.data.pendingCount == resource.data.pendingCount + 1 &&
        request.resource.data.pendingCount <= 5 &&
        request.resource.data.pendingDeckId != null &&
        deckAfter.ownerUid == uid &&
        deckAfter.status == 'pending' &&
        deckAfter.quotaMarker == request.resource.data.pendingDeckId;
    }

    function checkUserDecrement() {
      let deckPath = presentationPath(request.resource.data.pendingDeckId);
      return request.resource.data.pendingCount == resource.data.pendingCount - 1 &&
        request.resource.data.pendingCount >= 0 &&
        request.resource.data.pendingDeckId != null &&
        (
          !existsAfter(deckPath) ||
          getAfter(deckPath).data.status != 'pending'
        );
    }

    function checkUserQuotaOnDeckCreate(deckId) {
      let uPath = userPath(request.auth.uid);
      let userAfter = getAfter(uPath).data;
      let countBefore = exists(uPath) ? get(uPath).data.pendingCount : 0;
      return userAfter.pendingDeckId == deckId &&
        userAfter.pendingCount <= 5 &&
        userAfter.pendingCount == countBefore + 1;
    }

    function checkOwnerQuotaOnDeckUpdate(deckId) {
      let uPath = userPath(request.auth.uid);
      let userAfter = getAfter(uPath).data;
      let userBefore = get(uPath).data;
      return resource.data.status == 'pending' ?
        userAfter.pendingCount == userBefore.pendingCount :
        (
          userAfter.pendingDeckId == deckId &&
          userAfter.pendingCount == userBefore.pendingCount + 1 &&
          userAfter.pendingCount <= 5
        );
    }

    function checkAdminQuotaOnDeckUpdate(deckId, ownerUid) {
      let uPath = userPath(ownerUid);
      let userAfter = getAfter(uPath).data;
      let userBefore = get(uPath).data;
      return userAfter.pendingDeckId == deckId &&
        userAfter.pendingCount == userBefore.pendingCount - 1;
    }

    function checkQuotaOnDeckDelete(deckId, ownerUid) {
      let uPath = userPath(ownerUid);
      let userAfter = getAfter(uPath).data;
      let userBefore = get(uPath).data;
      return userAfter.pendingDeckId == deckId &&
        userAfter.pendingCount == userBefore.pendingCount - 1;
    }

    // --- Chunk Helpers ---

    function canReadChunk(deckId) {
      let deckPath = presentationPath(deckId);
      let deck = get(deckPath).data;
      return isMember() && (deck.status == 'published' || deck.ownerUid == request.auth.uid || isAdmin());
    }

    // Prototype v2: balanced deterministic sizes bind each chunk to the total, without a parent array.
    function canWriteChunk(deckId, chunkIdx) {
      let deckAfter = getAfter(presentationPath(deckId)).data;
      let chunk = request.resource.data;
      let baseSize = int(deckAfter.sizes.encoded / deckAfter.chunkCount);
      let remainder = deckAfter.sizes.encoded % deckAfter.chunkCount;
      let expectedSize = baseSize + (chunk.index < remainder ? 1 : 0);
      return isMember() && (deckAfter.ownerUid == request.auth.uid || isAdmin()) &&
        deckAfter.status == 'pending' && deckAfter.manifestVersion == 2 &&
        chunk.keys().hasOnly(['index', 'size', 'data']) &&
        chunk.index is int && chunk.index == int(chunkIdx) &&
        chunk.index >= 0 && chunk.index < deckAfter.chunkCount &&
        chunk.size is int && chunk.size > 0 && chunk.size <= 900000 &&
        chunk.data is bytes && chunk.data.size() == chunk.size && chunk.size == expectedSize;
    }

    function canDeleteChunkTail(deckId, chunkIdx) {
      let deckAfter = getAfter(presentationPath(deckId)).data;
      return (isMember() && (deckAfter.ownerUid == request.auth.uid || isAdmin())) &&
        int(chunkIdx) >= deckAfter.chunkCount;
    }

    function canDeleteChunkParentDeleted(deckId) {
      let deckBefore = get(presentationPath(deckId)).data;
      return isMember() && (deckBefore.ownerUid == request.auth.uid || isAdmin());
    }

    function canDeleteChunk(deckId, chunkIdx) {
      let deckPath = presentationPath(deckId);
      return !existsAfter(deckPath) ?
        canDeleteChunkParentDeleted(deckId) :
        canDeleteChunkTail(deckId, chunkIdx);
    }

    function canCreateDeck(id) {
      let data = request.resource.data;
      return isMember() &&
        data.ownerUid == request.auth.uid &&
        data.status == 'pending' &&
        data.rejectNote == "" &&
        (!('publishedAt' in data) || data.publishedAt == null) &&
        (!('reviewedBy' in data) || data.reviewedBy == null) &&
        (!('reviewedAt' in data) || data.reviewedAt == null) &&
        data.quotaMarker == id &&
        validateDeckFields(data) &&
        validateManifest(data) &&
        checkUserQuotaOnDeckCreate(id);
    }

    function canUpdateDeck(id) {
      let data = request.resource.data;
      let before = resource.data;
      return (
        isMember() &&
        request.auth.uid == before.ownerUid &&
        data.ownerUid == before.ownerUid &&
        data.createdAt == before.createdAt &&
        data.status == 'pending' &&
        data.rejectNote == "" &&
        (!('publishedAt' in data) || data.publishedAt == null) &&
        (!('reviewedBy' in data) || data.reviewedBy == null) &&
        (!('reviewedAt' in data) || data.reviewedAt == null) &&
        data.quotaMarker == id &&
        validateDeckFields(data) &&
        validateManifest(data) &&
        checkOwnerQuotaOnDeckUpdate(id)
      ) || (
        isAdmin() &&
        data.ownerUid == before.ownerUid &&
        data.createdAt == before.createdAt &&
        validateDeckFields(data) &&
        validateManifest(data) &&
        (
          data.status == 'published' ?
            (data.publishedAt != null && data.reviewedBy == request.auth.uid && data.reviewedAt != null) :
          data.status == 'rejected' ?
            (data.rejectNote.size() > 0 && data.reviewedBy == request.auth.uid && data.reviewedAt != null) :
            true
        ) &&
        (
          (before.status == 'pending' && data.status != 'pending') ?
            checkAdminQuotaOnDeckUpdate(id, before.ownerUid) :
            true
        )
      );
    }

    // --- Users Collection ---
    match /users/{uid} {
      allow list: if false;
      allow get: if isOwner(uid) || isAdmin();

      // Create user doc
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'pendingCount', 'pendingDeckId']) &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.pendingCount is int &&
        (
          // Case A: initial sign up without pending deck
          (request.resource.data.pendingCount == 0 &&
            (!('pendingDeckId' in request.resource.data) || request.resource.data.pendingDeckId == null)) ||
          // Case B: initial sign up with first pending deck in same atomic batch
          checkUserCreateWithDeck(uid)
        );

      // Update user doc
      allow update: if (
        isOwner(uid) &&
        request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'pendingCount', 'pendingDeckId']) &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100 &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.pendingCount is int &&
        (
          // Slot increment (+1): bound to presentation moving/entering pending
          checkUserIncrement(uid) ||
          // Slot decrement (-1): bound to presentation leaving pending or deleted
          checkUserDecrement() ||
          // No slot change: profile edit or pending->pending deck update
          (request.resource.data.pendingCount == resource.data.pendingCount)
        )
      ) || (
        // Admin decrement when approving/rejecting/deleting pending deck
        isAdmin() && checkUserDecrement()
      );

      allow delete: if false;
    }

    // --- Admins Collection (Console-only marker documents) ---
    match /admins/{uid} {
      allow get: if isMember() && isOwner(uid) && isAdmin();
      allow list, write: if false;
    }

    // --- Presentations Collection ---
    match /presentations/{id} {
      // Read access:
      // Published decks are readable only by verified members.
      // Non-published decks readable ONLY by their member owner or admins.
      allow read: if isMember() && (resource.data.status == 'published' || resource.data.ownerUid == request.auth.uid || isAdmin());

      // Create deck:
      // Must be member, ownerUid matches caller, status must start as pending.
      // Must increment user pendingCount via two-way getAfter binding.
      allow create: if canCreateDeck(id);

      // Update deck:
      // 1. Member owner update:
      //    ownerUid immutable, createdAt immutable.
      //    status forces to 'pending' (re-review required).
      //    If deck was pending, counter does NOT change.
      //    If deck was published/rejected/unpublished, new pending slot consumed.
      // 2. Admin update:
      //    Only admin sets status and review fields.
      //    If status moves away from pending, decrements owner's pendingCount.
      allow update: if canUpdateDeck(id);

      // Delete deck:
      // Published decks: Admin only.
      // Non-published decks: Owner or Admin.
      // If deleted deck was pending, must decrement user pendingCount.
      allow delete: if (
        (resource.data.status == 'published' && isAdmin()) ||
        (resource.data.status in ['pending', 'rejected', 'unpublished'] && (isMember() && (request.auth.uid == resource.data.ownerUid || isAdmin())))
      ) && (
        resource.data.status == 'pending' ?
          checkQuotaOnDeckDelete(id, resource.data.ownerUid) :
          true
      );

      // --- Chunks Subcollection ---
      match /chunks/{chunkIndex} {
        allow read: if canReadChunk(id);
        allow create, update: if canWriteChunk(id, chunkIndex);
        allow delete: if canDeleteChunk(id, chunkIndex);
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
